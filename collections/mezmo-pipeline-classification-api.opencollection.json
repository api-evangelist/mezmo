{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mezmo Pipeline Classification API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Classification",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Profile Sample Data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mezmo.com/v3/classification/profile",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Analyze a sample of pipeline data and return inferred field types, cardinality, and clusters."
        },
        {
          "info": {
            "name": "Suggest Parser",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mezmo.com/v3/classification/parse",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "AI-generate a parser configuration for the sample."
        },
        {
          "info": {
            "name": "Generate Regex",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mezmo.com/v3/classification/regex",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate a regex for the supplied sample tokens."
        }
      ]
    }
  ],
  "bundled": true
}