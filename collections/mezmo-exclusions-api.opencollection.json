{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mezmo Alerts Archiving Exclusions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Exclusions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Exclusion Rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mezmo.com/v1/config/ingestion/exclusions"
          },
          "docs": "List Exclusion Rules"
        },
        {
          "info": {
            "name": "Create Exclusion Rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mezmo.com/v1/config/ingestion/exclusions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Exclusion Rule"
        },
        {
          "info": {
            "name": "Update Exclusion Rule",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.mezmo.com/v1/config/ingestion/exclusions/:ruleid",
            "params": [
              {
                "name": "ruleid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Exclusion Rule"
        },
        {
          "info": {
            "name": "Delete Exclusion Rule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mezmo.com/v1/config/ingestion/exclusions/:ruleid",
            "params": [
              {
                "name": "ruleid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Exclusion Rule"
        }
      ]
    }
  ],
  "bundled": true
}