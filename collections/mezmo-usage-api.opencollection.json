{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mezmo Usage API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Usage By Type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mezmo.com/v1/usage/:type",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path"
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get Usage By Type"
        },
        {
          "info": {
            "name": "Get Detailed Usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mezmo.com/v2/usage",
            "params": [
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              },
              {
                "name": "groupby",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get Detailed Usage"
        }
      ]
    }
  ],
  "bundled": true
}