      "item": [
        {
          "id": "204deb78-dc14-4c68-99e6-1b9c9e6ef21b",
          "name": "Ingest Logs",
          "request": {
            "name": "Ingest Logs",
            "description": {
              "content": "Send a batch of log lines to Mezmo. Each line carries a timestamp, line\nbody, app, level, env, and free-form meta. Recommended batch size is\nunder 10 MB per request.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "logs",
                "ingest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "hostname",
                  "value": "<string>",
                  "description": "(Required) Originating host name for the batch."
                },
                {
                  "disabled": false,
                  "key": "mac",
                  "value": "<string>",
                  "description": "MAC address of the originating host."
                },
                {
                  "disabled": false,
                  "key": "ip",
                  "value": "<string>",
                  "description": "IP address of the originating host."
                },
                {
                  "disabled": false,
                  "key": "now",
                  "value": "<long>",
                  "description": "Current unix epoch milliseconds on the sending host."
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Comma-separated tags to attach to every line in the batch."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lines\": [\n    {\n      \"line\": \"<string>\",\n      \"timestamp\": \"<long>\",\n      \"app\": \"<string>\",\n      \"level\": \"<string>\",\n      \"env\": \"<string>\",\n      \"meta\": {\n        \"key_0\": 2935,\n        \"key_1\": false,\n        \"key_2\": 8885\n      }\n    },\n    {\n      \"line\": \"<string>\",\n      \"timestamp\": \"<long>\",\n      \"app\": \"<string>\",\n      \"level\": \"<string>\",\n      \"env\": \"<string>\",\n      \"meta\": {\n        \"key_0\": 1854\n      }\n    }\n  ]\n}",
              "options": {
