      "item": [
        {
          "id": "703c83c7-b8cd-4058-8ed5-f4401a1a5260",
          "name": "Ingest Logs",
          "request": {
            "name": "Ingest Logs",
            "description": {
              "content": "Send a batch of log lines to Mezmo. Each line carries a timestamp, line\nbody, app, level, env, and free-form meta. Recommended batch size is\nunder 10 MB per request.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "logs",
                "ingest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "hostname",
                  "value": "<string>",
                  "description": "(Required) Originating host name for the batch."
                },
                {
                  "disabled": false,
                  "key": "mac",
                  "value": "<string>",
                  "description": "MAC address of the originating host."
                },
                {
                  "disabled": false,
                  "key": "ip",
                  "value": "<string>",
                  "description": "IP address of the originating host."
                },
                {
                  "disabled": false,
                  "key": "now",
                  "value": "<long>",
                  "description": "Current unix epoch milliseconds on the sending host."
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Comma-separated tags to attach to every line in the batch."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lines\": [\n    {\n      \"line\": \"<string>\",\n      \"timestamp\": \"<long>\",\n      \"app\": \"<string>\",\n      \"level\": \"<string>\",\n      \"env\": \"<string>\",\n      \"meta\": {\n        \"key_0\": 4299.348908236951,\n        \"key_1\": 1509.2981376395564\n      }\n    },\n    {\n      \"line\": \"<string>\",\n      \"timestamp\": \"<long>\",\n      \"app\": \"<string>\",\n      \"level\": \"<string>\",\n      \"env\": \"<string>\",\n      \"meta\": {\n        \"key_0\": 191.1177439485645\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
