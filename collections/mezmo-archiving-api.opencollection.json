{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mezmo Archiving API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Archiving",
        "type": "folder"
      },
      "items": [
